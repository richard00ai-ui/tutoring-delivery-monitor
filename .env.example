# 复制成 .env,填真实值。程序运行时自动加载。

# 结果目录 (不设走 ./data)
# DATA_DIR=/Users/xxx/督学监控数据

# 学生名单 xlsx (不设走 ./督学服务整理.xlsx,主管每天导出这份)
# ROSTER_XLSX=./督学服务整理.xlsx

# 规则 YAML (不设走 ./rules.yaml)
# RULES_YAML=./rules.yaml

# 企微内部管理群 - 群机器人 webhook (未完成告警推这里)
# 空则跳过推送
WECOM_BOT_WEBHOOK=

# 保留几天 (默认 7)
RETENTION_DAYS=7

# 开发用假数据:true=mock, false=走 RPA
USE_MOCK=true

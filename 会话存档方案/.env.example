# 复制成 .env,填真实值

# ── 通用 ─────────────────────────────
DATA_DIR=/app/data
ROSTER_XLSX=/app/督学服务整理.xlsx
RULES_YAML=/app/rules.yaml
WECOM_BOT_WEBHOOK=
RETENTION_DAYS=7
ARCHIVE_MSGS_RETENTION_DAYS=10
USE_MOCK=false

# ── 会话存档 SDK(许可到位后填) ────────
WECOM_CORPID=
WECOM_SECRET=
SDK_LIB_PATH=/app/lib/libWeWorkFinanceSdk_C.so
PRIVATE_KEY_PATH=/app/keys/wecom.pri.pem

# 单次调度参数
FETCH_BATCH_SIZE=1000
FETCH_MAX_PER_RUN=50000
